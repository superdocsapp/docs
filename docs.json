        "url": "https://api.superdocs.app/health"
      }
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Website",
            "href": "https://typebar.ai"
          },
          {
            "label": "App",
            "href": "https://use.typebar.ai"
          }
        ]
      },
      {
        "header": "Support",
        "items": [
          {
            "label": "Contact",
            "href": "mailto:hello@superdocs.app"
          },
          {
            "label": "API Status",
