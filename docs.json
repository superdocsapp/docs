{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Typebar",
  "theme": "maple",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#110b0b",
    "light": "#fbfaf6",
    "dark": "#110b0b"
  },
  "markdown": {
    "instructions": [
      "Typebar, formerly SuperDocs. Same product, same API, same keys: nothing changes for your integration.",
      "Typebar, formerly SuperDocs, is not related to SuperDoc (superdoc.dev)."
    ]
  },
  "openapi": [
    "openapi.json"
  ],
  "api": {
    "playground": {
      "mode": "simple"
    }
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/introduction/quickstart" },
    { "source": "/overview", "destination": "/introduction/overview" },
    { "source": "/getting-started", "destination": "/introduction/overview" },
    { "source": "/agent-signup", "destination": "/introduction/agent-signup" },
    { "source": "/agents", "destination": "/introduction/agent-signup" },
    { "source": "/mcp", "destination": "/mcp/setup" },
    { "source": "/mcp/overview", "destination": "/mcp/setup" },
    { "source": "/api-reference/mcp/verify-the-superdocs-mcp-server-is-reachable-and-serving-traffic", "destination": "/api-reference/mcp/verify-the-typebar-mcp-server-is-reachable-and-serving-traffic" }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction/overview",
              "introduction/quickstart",
              "introduction/agent-signup",
              "introduction/agent-recipe"
            ]
          },
          {
            "group": "Capabilities",
            "pages": [
              "features"
            ]
          },
          {
            "group": "Account & Billing",
            "pages": [
              "account/account-setup",
              "account/api-keys",
              "account/mcp-setup",
              "account/plans-and-usage",
              "account/billing"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/sessions",
              "concepts/documents",
              "concepts/files",
              "concepts/cross-session-context",
              "concepts/attachments",
              "concepts/templates"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/integration-starter-prompt",
              "guides/streaming",
              "guides/async-jobs",
              "guides/human-in-the-loop",
              "guides/multi-document",
              "guides/concurrent-editing",
              "guides/editor-integration",
              "guides/agent-tool-integration",
              "guides/agent-editing-playbook",
              "guides/server-integration",
              "guides/model-selection",
              "guides/ai-to-ai"
            ]
          },
          {
            "group": "MCP Integration",
            "pages": [
              "mcp/setup",
              "mcp/plugin",
              "mcp/claude-code",
              "mcp/claude-desktop",
              "mcp/cursor-vscode",
              "mcp/available-tools"
            ]
          },
          {
            "group": "Errors & Limits",
            "pages": [
              "errors/error-codes",
              "errors/rate-limits"
            ]
          },
          {
            "group": "Code Examples",
            "pages": [
              "examples/python",
              "examples/javascript",
              "examples/curl"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.typebar.ai"
    }
  },
  "topbar": {
    "links": [
      {
        "name": "App",
        "url": "https://use.typebar.ai"
      },
      {
